{
  "name": "deepseek-code-agent",
  "version": "0.5.0",
  "description": "面向中文开发者的 DeepSeek 原生 CLI 编程 Agent",
  "type": "module",
  "bin": {
    "dsa": "./src/cli/main.ts"
  },
  "scripts": {
    "start": "tsx src/cli/main.ts",
    "dev": "tsx watch src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "context:audit": "tsx scripts/context-audit.ts"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "ink": "^7.1.0",
    "react": "^19.2.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0"
  }
}
